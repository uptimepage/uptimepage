# ─── uptimepage deployment configuration ────────────────────────────
#
# Copy this file to `.env` (in the same directory as docker-compose.yml)
# and fill in real values. Never commit .env to version control.
#
#     cp .env.example .env
#
# After editing, validate with:
#
#     docker compose config
#
# ─────────────────────────────────────────────────────────────────────────

# === Public-facing configuration ===

# Your BASE domain (apex), e.g. example.com — NOT a sub-host. Caddy serves:
#   app.{DOMAIN}              → operator UI + API
#   {slug}.status.{DOMAIN}    → per-org public status pages (SaaS mode)
#
# DNS records required (A or AAAA, pointing at this host):
#   app.example.com           → <server IP>
#   *.status.example.com      → <server IP>     (wildcard, SaaS mode only)
#
# Ports 80 and 443 must be reachable from the public internet.
UPTIMEPAGE_DOMAIN=example.com

# Email address for Let's Encrypt certificate expiry notifications.
UPTIMEPAGE_ACME_EMAIL=ops@example.com

# Hetzner Cloud API token — solves the ACME DNS-01 challenge for the
# *.status.{DOMAIN} WILDCARD certificate (HTTP-01 can't do wildcards).
# This is a Hetzner *Cloud* API token (the legacy dns.hetzner.com DNS
# tokens were retired 2026-05): Hetzner Console → your Project →
# Security → API Tokens → Read & Write. Tokens are project-scoped, so the
# DNS zone must be in the same project (zone → Actions → Transfer to
# project). Keep it secret. Required whenever the wildcard surface is
# served; harmless otherwise.
HETZNER_DNS_API_TOKEN=REPLACE_WITH_HETZNER_CLOUD_API_TOKEN


# === Operator authentication (GitHub OAuth) ===
#
# Authentication is enforced by the app, not the edge — there is no Caddy
# basic_auth. The operator UI + API live behind a GitHub OAuth session;
# the public per-org status pages stay unauthenticated.
#
# Create a GitHub OAuth App:
#   github.com → Settings → Developer settings → OAuth Apps → New OAuth App
#     Homepage URL:              https://app.{DOMAIN}
#     Authorization callback URL: https://app.{DOMAIN}/auth/github/callback
#   Register, copy the Client ID, then "Generate a new client secret".
#
# CLIENT_ID is public (it appears in the browser redirect). CLIENT_SECRET
# is a secret — treat it like a password. REDIRECT_URL must EXACTLY match
# the OAuth App's callback URL. PUBLIC_BASE_URL is the external origin the
# app uses to build OAuth and emailed links (no trailing slash needed).

UPTIMEPAGE_AUTH_GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
UPTIMEPAGE_AUTH_GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
UPTIMEPAGE_AUTH_GITHUB_REDIRECT_URL=https://app.example.com/auth/github/callback
UPTIMEPAGE_AUTH_PUBLIC_BASE_URL=https://app.example.com


# === Database passwords ===
#
# Generate strong random passwords with:
#
#     openssl rand -base64 24
#
# These never leave the docker network — they're used for service-to-service
# auth between uptimepage and PostgreSQL/ClickHouse. Even so, treat them
# as secrets.

POSTGRES_PASSWORD=CHANGE_ME_strong_random_value
CLICKHOUSE_PASSWORD=CHANGE_ME_strong_random_value


# === Application encryption ===
#
# Key Encryption Key (KEK) for at-rest encryption of credentials stored in
# target configurations (basic_auth passwords, bearer tokens). Used by the
# AES-256-GCM credential encryption in `src/security/`.
#
# Generate with:
#
#     openssl rand -base64 32
#
# If you ROTATE this key, all existing encrypted credentials become
# unreadable. Plan a migration path before changing.

UPTIMEPAGE_CREDENTIALS_KEK_BASE64=REPLACE_WITH_RANDOM_32_BYTES_BASE64

# CIDR ranges whose X-Forwarded-For the app honours when extracting the
# client IP. Required because Caddy sits in front of the app in the
# default compose stack — without this every `ip_hash` collapses to the
# Caddy container's address and the per-IP abuse / audit indexes are
# useless. Standard Docker bridge ranges + loopback cover the in-stack
# deployment; add your CDN's published IP ranges if you front the stack
# with one. Comma-separated, no spaces.
UPTIMEPAGE_SECURITY__TRUSTED_PROXIES=172.16.0.0/12,127.0.0.0/8,::1/128


# === Public status pages ===
#
# Path-based (default): orgs share the operator host; each org's page lives
# at https://app.{DOMAIN}/status/<slug>. No wildcard cert or DNS token
# needed.
#
# Subdomain: each org at https://{slug}.{DOMAIN}. Set:
#
#     UPTIMEPAGE_SUBDOMAIN_PUBLIC_ROUTES=true
#     UPTIMEPAGE_PATH_BASED_PUBLIC_ROUTES=false
#     UPTIMEPAGE_AUTH_FINGERPRINT_SALT='<openssl rand -base64 32>'
#
# The app refuses to boot if SUBDOMAIN is true while UPTIMEPAGE_DOMAIN
# has no dot, or if the fingerprint salt is empty. Subdomain mode requires
# HETZNER_DNS_API_TOKEN above (wildcard cert).
#
# UPTIMEPAGE_SUBDOMAIN_PUBLIC_ROUTES=false
# UPTIMEPAGE_PATH_BASED_PUBLIC_ROUTES=true


# === MCP server (LLM connector) ===
#
# Read-only + write MCP tools for LLM clients (Claude Desktop, claude.ai).
# Normally managed from GitHub: set repo *variables* MCP_ENABLED / MCP_OAUTH_
# ENABLED (Settings → Secrets and variables → Actions → Variables) and
# deploy.yml upserts UPTIMEPAGE_MCP_ENABLED / _OAUTH_ENABLED here on each
# deploy. You can also set them directly in this file.
#
#   - UPTIMEPAGE_MCP_ENABLED=true        mounts /mcp + read/write tools.
#   - UPTIMEPAGE_MCP_OAUTH_ENABLED=true  adds the OAuth 2.1 endpoints that back
#     the claude.ai one-click connector.
#
# Requirements when OAuth is on (else the app refuses to boot):
#   - UPTIMEPAGE_AUTH_PUBLIC_BASE_URL must be a real https origin (the issuer).
#   - The resource id defaults to https://mcp.{UPTIMEPAGE_DOMAIN}/mcp; override
#     with UPTIMEPAGE_MCP_RESOURCE_URI if needed. `mcp.{DOMAIN}` resolves via
#     the *.{DOMAIN} wildcard record (no new DNS) and has its own Caddy site
#     block; the app serves only /mcp and /.well-known/* on it.
#
# UPTIMEPAGE_MCP_ENABLED=true
# UPTIMEPAGE_MCP_OAUTH_ENABLED=true
# UPTIMEPAGE_MCP_RESOURCE_URI=https://mcp.example.com/mcp


# === Image source (optional) ===
#
# By default the compose file BUILDS uptimepage from this repo
# (`build: { context: .. }`) and tags the result `uptimepage:latest`.
# That works when the host has the repo checked out and the toolchain.
#
# To pull a pre-built image from a registry instead:
#
#   1. Set UPTIMEPAGE_IMAGE to the registry reference.
#   2. Pull it explicitly:    docker compose pull uptimepage
#   3. Start without building: docker compose up -d --no-build
#
# (Compose with both `build` and `image` keys will try to BUILD on a plain
# `up -d`; --no-build forces it to use the pulled image. Once published
# images are how you deploy, you may want to delete the `build:` block
# from docker-compose.yml entirely.)
#
# UPTIMEPAGE_IMAGE=ghcr.io/your-org/uptimepage:v1.2.3


# === Grafana Cloud metrics (optional) ===
#
# Ship the in-binary Prometheus metrics to Grafana Cloud via a Grafana
# Alloy sidecar. This is OFF by default. To enable:
#
#   1. Set the three values below from your Grafana Cloud stack:
#      Connections → Prometheus → "Sending metrics from ...".
#   2. Start the stack with the metrics profile:
#        docker compose --profile metrics up -d
#
# GRAFANA_CLOUD_PROM_URL is the remote-write endpoint (note the
# prod-XX-<zone> segment — copy it exactly from the Grafana Cloud UI).
# GRAFANA_CLOUD_PROM_USER is the numeric instance / stack id.
# GRAFANA_CLOUD_API_TOKEN is an access-policy token scoped to
# metrics:write ONLY. It is a secret — it lives only in this file
# (.env is gitignored) and is never logged.
#
# GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-REGION.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROM_USER=000000
# GRAFANA_CLOUD_API_TOKEN=glc_replace_me
#
# Optional: label that identifies this sender in Grafana Cloud. Set a
# unique value per host if you run more than one operator instance,
# otherwise their series collide. Defaults to "uptimepage".
# GRAFANA_CLOUD_INSTANCE=uptimepage


# === Grafana Cloud traces (optional) ===
#
# In-app OpenTelemetry trace export over OTLP/HTTP. Separate from the
# metrics path above: traces go straight from the binary to the OTLP
# gateway (no Alloy). Off unless ENABLED + TRACING_ENABLED are true and
# the endpoint/id/token are set. Both switches must be true.
#
# GRAFANA_OTLP_ENDPOINT is the OTLP base (no /v1/traces suffix) — find
# it under Connections → OpenTelemetry in Grafana Cloud.
# GRAFANA_OTLP_INSTANCE_ID is the numeric instance / stack id.
# GRAFANA_OTLP_API_TOKEN is an access-policy token scoped to
# traces:write ONLY. It is a secret — kept only here (.env is
# gitignored) and never logged.
#
# UPTIMEPAGE_TRACING_ENABLED=true
# GRAFANA_OTLP_ENABLED=true
# GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-REGION.grafana.net/otlp
# GRAFANA_OTLP_INSTANCE_ID=000000
# GRAFANA_OTLP_API_TOKEN=glc_replace_me


# === Grafana Cloud logs (optional) ===
#
# Container stdout shipped to Grafana Cloud Loki by the SAME Alloy
# sidecar as metrics (rides the "metrics" compose profile — the metrics
# trio above is the prerequisite; Loki alone does not start the
# sidecar). Only the uptimepage container's logs are shipped.
# Inert until both values below are set: config.alloy resolves an
# unreachable placeholder URL, so metrics keep flowing untouched.
#
# GRAFANA_CLOUD_LOKI_URL is the Loki push endpoint (note the
# /loki/api/v1/push path) from Connections → Loki in Grafana Cloud.
# GRAFANA_CLOUD_LOKI_USER is the numeric Loki instance / stack id
# (distinct from the Prometheus and OTLP ids).
# No separate token: this reuses GRAFANA_CLOUD_API_TOKEN above — that
# access-policy token just needs `logs:write` added to its scopes.
#
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=000000


# === Logging ===
#
# Standard tracing-subscriber filter. Read BEFORE the config file, so
# this is the authoritative level. HTTP request spans (and therefore
# OTLP traces) are emitted at debug — keep this at least `debug` for
# traces to appear. Deploy-managed: the deploy pipeline upserts this
# from the GitHub repo variable RUST_LOG; unset falls back to `debug`.
# Examples:
#   debug                      — verbose (default; request spans recorded)
#   info                       — quieter; NO request spans / OTLP traces
#   uptimepage=debug,info  — our crate (incl. request spans) at debug,
#                                dependencies at info — recommended balance
#   warn                       — only warnings and errors

RUST_LOG=debug


# === Operator surface ===
#
# Static bearer secret for /operator/* (regions, agents, account plans and
# cap overrides). Empty = the surface is absent (404). The compose file hands
# this to the app as UPTIMEPAGE_OPERATOR__ADMIN_TOKEN, which is the name the
# docs use; here it is the single-underscore form. Needed before the agent
# split below, since the region and its token are provisioned through it.
#
#     openssl rand -base64 32
#
# UPTIMEPAGE_OPERATOR_ADMIN_TOKEN=

# === Probing topology (dashboard / agent split) ===
#
# --- disposable email addresses -------------------------------------------
# What a throwaway address does at signup. "flag" (the default) opens the
# account and marks users.email_risk, visible in the back-office user list;
# "block" refuses it; "allow" ignores the signal at signup entirely.
# Invitations, status-page subscriptions and email notification channels
# refuse a throwaway address regardless of this setting — those are the
# surfaces where one turns into a bounce against our sending reputation.
# Start on flag, watch the marks, then decide.
#
# UPTIMEPAGE_EMAIL_POLICY_SIGNUP_POLICY=block

# Off by default. The MX check resolves through the public servers in
# `[dns] servers`, so an install whose staff mail lives on an internal domain
# would refuse its own addresses everywhere. Turn it on when the addresses you
# serve are public ones.
#
# UPTIMEPAGE_EMAIL_POLICY_ENABLED=true

# Default (all keys unset): all-in-one — this process probes its own region.
# Simple, but the region has no agents row, so silence detection can't see it
# is alive. Recommended for production: run this process as a pure dashboard and
# a co-located `agent` service (the `agent` compose profile) as the region's
# probe — then liveness is uniform and silence detection is correct.
#
# To run the split:
#   1. UPTIMEPAGE_SCHEDULER_ENABLED=false   (stop in-process probing)
#   2. set the home region id (e.g. eu-helsinki) — new monitors assign here and
#      the co-located agent inherits it as its region.
#   3. provision the region + an agent token on the operator surface (see
#      AGENT.md), then set HOME_AGENT_TOKEN.
#   4. start the agent: `docker compose --profile agent up -d agent`. Order
#      matters — provision + start the agent BEFORE flipping
#      SCHEDULER_ENABLED=false, or the region goes dark in the gap.
#   5. later image moves go through the `deploy-agent` workflow, which pins
#      AGENT_IMAGE here; a dashboard deploy never restarts the agent. Unset,
#      the agent follows UPTIMEPAGE_IMAGE.
#
# UPTIMEPAGE_SCHEDULER_ENABLED=false
# UPTIMEPAGE_SCHEDULER_REGION=eu-helsinki
# UPTIMEPAGE_SCHEDULER_DEFAULT_REGION=eu-helsinki
# AGENT_CONTROL_PLANE_URL=https://app.example.com
# HOME_AGENT_TOKEN=sm_agent_...
# AGENT_IMAGE=ghcr.io/uptimepage/uptimepage:sha-<full40>
#
# Browser flow monitors. The engine ships in every image but stays off, because
# a flow spawns a real browser per check and is far heavier than the other
# kinds. Turn it on for the regions whose host can carry it and leave the rest
# alone — an agent that does not advertise the capability is never handed a
# flow, so nothing there fails. A flow monitor can only pick regions that
# advertise it, and quorum needs two such regions to mean anything.
# AGENT_FLOW_ENABLED=true
