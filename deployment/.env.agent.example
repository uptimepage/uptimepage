# Regional probe agent config. Copy to `.env` next to docker-compose.agent.yml
# on the agent box and fill in. The token is a capability — keep it out of
# version control.

# The EXACT image the control plane runs (pin to the same sha so probe
# behaviour matches). Same value as UPTIMEPAGE_IMAGE on the control plane.
UPTIMEPAGE_IMAGE=ghcr.io/uptimepage/uptimepage:latest

# HTTPS origin of the control plane (no trailing path). The agent pulls
# /api/agent/targets and posts /api/agent/results here.
AGENT_CONTROL_PLANE_URL=https://app.uptimepage.dev

# The sm_agent_ token returned ONCE by POST /operator/agents when this box was
# minted. Rotating it = delete + recreate the agent (see AGENT.md).
AGENT_TOKEN=

# The region id this agent serves. Must already exist (POST /operator/regions)
# and match the region the agent was minted in.
AGENT_REGION=

# A page saying who runs this agent and how to reach them, linked from every
# probe's User-Agent. Empty links the project's page, which tells site owners
# the request came from a self-hosted copy.
AGENT_BOT_URL=

# Optional tuning (defaults shown).
# AGENT_PULL_INTERVAL_SECS=30
# AGENT_FLUSH_INTERVAL_SECS=5
# AGENT_BUFFER_CAPACITY=10000
# RUST_LOG=info,uptimepage=info
