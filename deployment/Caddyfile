# Caddyfile — Production reverse proxy for uptimepage (SaaS layout)
#
# Subdomain layout (UPTIMEPAGE_DOMAIN is the BASE domain, e.g. example.com):
#   app.{domain}              → Operator UI + API (the app gates its own
#                               routes; no edge credential), plus the
#                               single-org /status page in self-host mode
#   *.{domain}                → Per-org public status pages (wildcard cert,
#                               apex-wildcard shape — `acme.{domain}`, not
#                               `acme.status.{domain}`)
#
# What this does:
#   - Automatic HTTPS via Let's Encrypt (HTTP/2 and HTTP/3)
#   - app.{domain} cert on its own block (per-host HTTP-01) — kept off the
#     wildcard so a leak of the wildcard key never touches the operator host
#   - *.{domain} wildcard cert via Hetzner DNS-01 (scoped to that site —
#     self-host needs no DNS token)
#   - Operator UI + API behind the app's GitHub OAuth session (no edge auth)
#   - Public health probes (no auth) at /healthz and /readyz
#   - Hides /metrics from the public internet (still scrapeable internally)
#   - Per-IP rate limit on the public status surface
#   - Security headers (HSTS, X-Frame-Options, CSP, etc.)
#   - JSON access logs with rotation
#
# Required environment variables (see .env.example):
#   UPTIMEPAGE_DOMAIN       — base domain, e.g. example.com
#   UPTIMEPAGE_ACME_EMAIL   — for Let's Encrypt notifications
#
# Required only for the *.{domain} wildcard surface (SaaS):
#   HETZNER_DNS_API_TOKEN       — zone-edit token for the DNS-01 challenge
{
	email {$UPTIMEPAGE_ACME_EMAIL}

	# No global `acme_dns`: that would force DNS-01 on app.{domain} too and
	# make self-host depend on a Hetzner token it doesn't need. The DNS-01
	# issuer is scoped into the wildcard site block instead. Keeping
	# app.{domain} on its own per-host cert also caps the blast radius of a
	# wildcard-key leak (it doesn't cover the operator host).

	# Uncomment ONLY while testing — uses Let's Encrypt staging CA so you
	# don't hit production rate limits. Staging certs are NOT browser-trusted.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	# {remote_host} must be the real client IP for the public rate limiter.
	servers {
		trusted_proxies static private_ranges
	}
}

# ═══════════════════════════════════════════════════════════════════════
# Shared app upstream — blue/green replicas
# ═══════════════════════════════════════════════════════════════════════
# Both app colors with active health checks. Steady state one color is up; the
# stopped color fails /readyz and is held out of rotation. During a deploy's
# brief overlap both are healthy and round-robined (same DB, harmless).
# Imported by every site block below so the upstream is defined once.
(app_upstream) {
	reverse_proxy uptimepage_blue:8080 uptimepage_green:8080 {
		lb_policy round_robin
		lb_try_duration 5s
		header_up X-Real-IP {remote_host}

		# Liveness, not readiness. The app binds its HTTP listener only after
		# migrations finish, so a freshly booted, still-migrating color can't
		# answer /healthz yet — it stays out of rotation until it's actually
		# serving. /readyz would be wrong here: it 503s whenever Postgres is
		# briefly unreachable, which would eject every upstream and 502 the
		# whole edge on a transient blip. The deploy gates the cutover on
		# /readyz separately, before stopping the old color. Caddy preserves
		# the inbound Host + X-Forwarded-* by default, so the public status +
		# marketing surfaces still see the original Host for routing.
		health_uri /healthz
		health_interval 5s
		health_timeout 3s
		# No fail_duration on purpose. Passive health checking counts a
		# client-side abort as an upstream failure, so one browser hanging up
		# on a resumed HTTP/3 connection benched the only live color and 503'd
		# the whole edge for 10s. The active check above already ejects a dead
		# color, and lb_try_duration covers the deploy-window retry.

		transport http {
			dial_timeout 5s
			# Must exceed ad_hoc_dispatch::RESULT_WAIT (30s), which the
			# check-now long poll awaits in full.
			response_header_timeout 60s
			read_buffer 64KB
			write_buffer 64KB
		}
	}
}

# Open by design (RFC 7591), one row per call; the app sweeps unapproved rows,
# this caps the inflow. Public tier: MCP clients share their vendor's egress IP.
# Imported by both site blocks because mcp.{domain} is served by the wildcard.
(oauth_register) {
	@oauth_register {
		method POST
		path /oauth/register
	}
	handle @oauth_register {
		rate_limit {
			zone oauth_register {
				key {remote_host}
				ipv6_prefix 64
				events 30
				window 1m
			}
		}
		import app_upstream
	}
}

# ═══════════════════════════════════════════════════════════════════════
# Operator UI + API
# ═══════════════════════════════════════════════════════════════════════
app.{$UPTIMEPAGE_DOMAIN} {
	encode gzip zstd

	# ─── Public health endpoints (no auth) ──────────────────────────────
	# Deliberately public so uptime monitors, load balancers, and
	# orchestrators (k8s probes, Render health checks, etc.) can hit them
	# without credentials.
	@health path /healthz /readyz
	handle @health {
		import app_upstream
	}

	# ─── Block Prometheus metrics from the public internet ──────────────
	# uptimepage exposes /metrics on :9090 (separate port), scraped on
	# the internal docker network only. Return 404 so a misconfigured
	# Prometheus or curious attacker can't enumerate your fleet.
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond "Not Found" 404
	}

	# ─── Static assets — fingerprinted, immutable, no per-IP throttle ────
	# Bundled JS/CSS carry a content hash (?v=<fp>) so a changed file is a new
	# URL; safe to cache forever. One operator page pulls a dozen at once, which
	# the abuse-tier status cap (60/min) would 429 — keep them out of that zone.
	# Terminal handle, matched before @public; the app serves them unauthenticated.
	@static path /static/*
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		import app_upstream
	}

	# ─── Public status surface (self-host, no auth) ─────────────────────
	# Self-host serves its single org's status page, public JSON API, and
	# bundled assets here. `handle` is terminal, so these get their own
	# rate-limit zone instead of the catch-all's; what makes them public is
	# that the routes carry no auth extractor, not anything at the edge. In
	# SaaS the Host is `app.{domain}` (no slug), so the app 404s these and
	# the wildcard site is the real public surface — keeping this block is
	# harmless there. Distinct rate-limit zone from the wildcard site (zone
	# names are global to the Caddy process).
	@public path /status /status/* /api/public/* /robots.txt /favicon.ico
	handle @public {
		rate_limit {
			zone status_path {
				key {remote_host}
				ipv6_prefix 64
				events 60
				window 1m
			}
		}
		header Cache-Control "public, max-age=10, stale-while-revalidate=30"
		import app_upstream
	}

	# ─── Per-IP limits on the abuse-sensitive endpoints ─────────────────
	# Caddy owns the per-IP tier (it sees the real peer; the app keys on
	# org/user, never the TCP peer). The app-side per-org/user limits live
	# in the plans table. Zones are process-global, so a name is shared
	# across sites only where one budget is meant (oauth_register).
	# `ipv6_prefix 64`: a v6 client rotates addresses inside its routed
	# prefix at will, so a per-address bucket caps nothing.
	@auth path /auth/* /api/v1/me
	handle @auth {
		rate_limit {
			zone auth_endpoints {
				key {remote_host}
				ipv6_prefix 64
				events 10
				window 1m
			}
		}
		import app_upstream
	}

	import oauth_register

	# Org creation — strict speedbump against naive mass-signup abuse.
	@org_creation {
		method POST
		path /api/v1/orgs
	}
	handle @org_creation {
		rate_limit {
			zone org_creation {
				key {remote_host}
				ipv6_prefix 64
				events 3
				window 24h
			}
		}
		import app_upstream
	}

	# ─── Login page — defense-in-depth speedbump ────────────────────────
	# /login is public + unauthenticated. The app already collapses its
	# readiness probe to <=1 PG ping / 5s and 500ms-bounds it, so this zone
	# is purely an edge cap so an anonymous flood can't turn the catch-all
	# proxy into an amplifier (it otherwise has no rate limit). The OAuth
	# round-trip itself (/auth/*) is covered by @auth above; this is just
	# the page render. Generous (public-surface tier, not the credential
	# tier) so shared-NAT humans are never throttled — only a flood orders
	# of magnitude higher trips it. Terminal handle: keeps /login off the
	# unlimited catch-all. Zone names are process-global.
	@login path /login
	handle @login {
		rate_limit {
			zone login_page {
				key {remote_host}
				ipv6_prefix 64
				events 60
				window 1m
			}
		}
		import app_upstream
	}

	# ─── Share links — anonymous, per-IP edge cap ───────────────────────
	# /m/{token} is the only unauthenticated, app-served surface with no
	# subject to key on (the app limiter keys on org/user; a share request
	# has neither). The /m/{token}/{latency,results} sub-resources query
	# ClickHouse uncached, so an unthrottled flood on a shared link would
	# amplify into aggregation load. Caddy owns the per-IP tier here (it
	# sees the real peer). Generous public-surface tier so a link dropped in
	# a busy Slack channel never throttles real viewers — only a flood orders
	# of magnitude higher trips it. Terminal handle: keeps /m/ off the
	# unlimited catch-all. Zone names are process-global.
	@share path /m/*
	handle @share {
		rate_limit {
			zone share_links {
				key {remote_host}
				ipv6_prefix 64
				events 60
				window 1m
			}
		}
		import app_upstream
	}

	# ─── Heartbeat pings, anonymous capability token, per-IP edge cap ───
	# The per-token app limiter can't stop a token-enumeration flood (each
	# random token is a fresh key), so Caddy caps per-IP. Generous ceiling: a
	# throttled legit ping is a missed heartbeat that would open a false
	# incident, so only a flood far above any real cron fleet trips it.
	@heartbeat_ping path /ping/*
	handle @heartbeat_ping {
		rate_limit {
			zone heartbeat_ping {
				key {remote_host}
				events 600
				window 1m
			}
		}
		import app_upstream
	}

	# ─── Email-channel verification — anonymous token link ──────────────
	# Single-use sha256-at-rest tokens; the per-IP cap bounds brute probing
	# of the public endpoint.
	@verify_channel path /verify-channel*
	handle @verify_channel {
		rate_limit {
			zone verify_channel {
				key {remote_host}
				ipv6_prefix 64
				events 30
				window 1m
			}
		}
		import app_upstream
	}

	# ─── Public subscription surface — anonymous, per-IP edge cap ───────
	# POST /subscribe mints a confirm mail; GET confirm/unsubscribe carry
	# their own token/HMAC. Per-page and per-subscriber DB caps already bound
	# mail volume; this caps one IP fanning across many addresses.
	@subscribe path /subscribe /subscribe/*
	handle @subscribe {
		rate_limit {
			zone subscribe {
				key {remote_host}
				ipv6_prefix 64
				events 20
				window 1m
			}
		}
		import app_upstream
	}

	# ─── Invitation token surface — anonymous token links ───────────────
	# The GET landings and their JSON twins argon2-verify the emailed token
	# (decline is fully anonymous); the per-IP cap bounds brute probing.
	@invitations path /invitations/* /api/v1/invitations/*
	handle @invitations {
		rate_limit {
			zone invitation_links {
				key {remote_host}
				ipv6_prefix 64
				events 30
				window 1m
			}
		}
		import app_upstream
	}

	# ─── On-demand checks — per-IP edge cap ahead of the org limiter ─────
	# A multi-region Test costs one event per region (one request each).
	@on_demand_checks {
		method POST
		path /api/v1/targets/test /api/v1/targets/*/check-now
	}
	handle @on_demand_checks {
		rate_limit {
			zone on_demand_checks {
				key {remote_host}
				ipv6_prefix 64
				events 60
				window 1m
			}
		}
		import app_upstream
	}

	# ─── Delegation connect pages — anonymous single-use codes ──────────
	# Possession of the code is the authority; the per-IP cap bounds brute
	# probing while leaving room for the page's 5 s status poll.
	@delegate_connect path /c/*
	handle @delegate_connect {
		rate_limit {
			zone delegate_connect {
				key {remote_host}
				ipv6_prefix 64
				events 60
				window 1m
			}
		}
		import app_upstream
	}

	# ─── Telegram bot webhook — anonymous, per-IP edge cap ──────────────
	# Authenticated in-app by the secret-token header (constant-time); the
	# edge caps junk floods and bounds the body (real updates are < 4 KB).
	# Telegram delivers from a handful of egress IPs and retries non-2xx
	# with backoff, so a 429 defers an update, never loses it — keep the
	# cap generous enough for legitimate bursts. Terminal handle: keeps
	# the path off the unlimited catch-all.
	@telegram_hook path /hooks/telegram
	handle @telegram_hook {
		request_body {
			max_size 64KB
		}
		rate_limit {
			zone telegram_hook {
				key {remote_host}
				events 120
				window 1m
			}
		}
		import app_upstream
	}

	# ─── Resend bounce webhook — anonymous, per-IP edge cap ─────────────
	# Authenticated in-app by the Svix signature (HMAC, constant-time);
	# Svix retries non-2xx with backoff, so a 429 defers a delivery,
	# never loses it. Same body bound as the Telegram hook.
	@resend_hook path /hooks/resend
	handle @resend_hook {
		request_body {
			max_size 64KB
		}
		rate_limit {
			zone resend_hook {
				key {remote_host}
				events 120
				window 1m
			}
		}
		import app_upstream
	}

	# ─── WhatsApp (Meta) webhook — anonymous, per-IP edge cap ───────────
	# Authenticated in-app by X-Hub-Signature-256 (HMAC, constant-time);
	# the GET is Meta's one-time subscribe handshake. Meta retries non-2xx
	# with backoff. Same body bound as the other hooks.
	@whatsapp_hook path /hooks/whatsapp
	handle @whatsapp_hook {
		request_body {
			max_size 64KB
		}
		rate_limit {
			zone whatsapp_hook {
				key {remote_host}
				events 120
				window 1m
			}
		}
		import app_upstream
	}

	# ─── Operator surface: app-enforced session auth (SaaS) ─────────────
	# No edge basic_auth. The health/metrics/public handle blocks above
	# are terminal; every other (operator) request falls through to the
	# catch-all reverse_proxy below. In SaaS the Rust app session-gates
	# those routes itself (GitHub OAuth → signed cookie); an edge
	# basic_auth would double-prompt and break the app's OAuth round-trip.
	#
	# Self-host works the same way, regardless of tenancy: `AuthedBrowser`
	# redirects unauthenticated page loads to /login, and the /api/v1
	# extractors reject them with a 401 envelope. NOTE this is a lock, not
	# an allowlist — OAuth sign-up creates an org for any identity that
	# completes the flow, so an internet-facing self-host wants a network
	# or edge restriction if strangers should not be able to register.

	# ─── Security headers ───────────────────────────────────────────────
	# The operator app is a private surface: keep it out of search indexes so
	# its login and legal pages don't duplicate the marketing site.
	# payment: Paddle.js probes ApplePaySession on /pay itself and opens the
	# checkout in a buy.paddle.com iframe with allow="payment"; a blanket
	# payment=() hides Apple Pay and Google Pay from the checkout.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy `geolocation=(), microphone=(), camera=(), payment=(self "https://buy.paddle.com" "https://sandbox-buy.paddle.com")`
		X-Robots-Tag "noindex"
		-Server
		-X-Powered-By
	}

	# ─── Access logs ────────────────────────────────────────────────────
	# Skip health endpoints — otherwise every Caddy probe (every 30s) plus
	# external uptime checks flood the log with ~3k+ lines/day of noise.
	log_skip @health
	log {
		output file /var/log/caddy/access-app.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format json
	}

	# ─── Reverse proxy to the Rust service ──────────────────────────────
	import app_upstream
}

# ═══════════════════════════════════════════════════════════════════════
# Public per-org status pages — apex wildcard
# ═══════════════════════════════════════════════════════════════════════
# Every {slug}.{domain} resolves here EXCEPT app.{domain}, which Caddy
# matches more-specific-first against the operator site block above (Caddy
# routes the exact host before the wildcard, so the wildcard cert never
# covers the operator host). The Rust app reads the original Host header to
# map the slug → org; an unknown or opted-out slug is a 404 from the app,
# never a cert error (the wildcard cert covers all valid labels).
*.{$UPTIMEPAGE_DOMAIN} {
	encode gzip zstd

	# Wildcard cert via Hetzner DNS-01 (HTTP-01 can't validate a wildcard),
	# scoped to this site only. First issuance: Caddy writes a
	# `_acme-challenge.{domain}` TXT record through the Hetzner Cloud DNS
	# API, Let's Encrypt validates it, cert issued — allow 60-90s. Renewals
	# are silent. self-host never reaches this site, so it needs no DNS
	# token. HETZNER_DNS_API_TOKEN is a Hetzner Cloud API token (project
	# scoped, Read & Write) and the zone must be in that project.
	tls {
		dns hetzner {$HETZNER_DNS_API_TOKEN}
		# The new Cloud DNS API can lag a few seconds before the TXT is
		# visible to Let's Encrypt's resolvers; wait, then verify against
		# public resolvers rather than Hetzner's own.
		propagation_delay 30s
		propagation_timeout 5m
		resolvers 1.1.1.1 8.8.8.8
	}

	# ─── Per-IP rate limit — public surface ─────────────────────────────
	# Needs the caddy-ratelimit plugin (baked into Dockerfile.caddy).
	rate_limit {
		zone status_pages {
			key {remote_host}
			ipv6_prefix 64
			events 60
			window 1m
		}
	}

	# Public cache hints — the app also has its own short-TTL page cache.
	header Cache-Control "public, max-age=10, stale-while-revalidate=30"

	# Strict CSP for the public page.
	header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"

	# No identifiable headers.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-X-Powered-By
	}

	log {
		output file /var/log/caddy/access-status.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format json
	}

	import oauth_register

	# The app reads the original Host to map slug → org; Caddy forwards it
	# upstream by default.
	import app_upstream
}

# ═══════════════════════════════════════════════════════════════════════
# Marketing site (apex) — www 301-redirects here for one canonical host.
# ═══════════════════════════════════════════════════════════════════════
# The bare {domain} is served by the uptimepage container; the Rust
# dispatcher (web/host.rs::classify_host + the RouteByHost service) hands
# marketing requests off inside the binary. Apex and www each carry their
# own per-host HTTP-01 cert, kept off the *.{domain} wildcard so a
# wildcard-key leak still doesn't touch the marketing surface or the
# operator host.

# www serves only a redirect, but still needs its own cert to complete the
# TLS handshake first; {uri} preserves the path and query to apex.
www.{$UPTIMEPAGE_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	redir https://{$UPTIMEPAGE_DOMAIN}{uri} permanent
}

{$UPTIMEPAGE_DOMAIN} {
	encode gzip zstd

	# IndexNow ownership proof. Terminal handle, so the key file never
	# reaches the proxy below. Key is public by protocol.
	@indexnow path /8d50633e3e290894520514e27caf0587.txt
	handle @indexnow {
		respond "8d50633e3e290894520514e27caf0587" 200
	}

	# Send the canonical-host signal to the dispatcher. Marketing reads
	# the Host header to decide between landing and a tenant fall-through;
	# Caddy forwards Host + X-Forwarded-* upstream by default.
	handle {
		import app_upstream
	}

	# Marketing surfaces are public, cacheable, JS-free; no edge auth.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		# CSP for the marketing surface: same-origin static + JSON-LD inline
		# blob, plus the self-hosted analytics script and its event beacon.
		# img-src also allows our own status badge served from the status host.
		# form-action names the app host because Chrome applies it to the whole
		# redirect chain, and /start hands the hero's URL to the app's login.
		# connect-src names the two DoH resolvers the DNS tool reads from the
		# visitor's own browser, which is why that tool needs no egress here.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://uptimepage.{$UPTIMEPAGE_DOMAIN}; style-src 'self'; script-src 'self' https://analytics.{$UPTIMEPAGE_DOMAIN}; connect-src 'self' https://analytics.{$UPTIMEPAGE_DOMAIN} https://cloudflare-dns.com https://dns.google; base-uri 'self'; form-action 'self' https://app.{$UPTIMEPAGE_DOMAIN}; frame-ancestors 'none'"
		-Server
	}

	log {
		output file /var/log/caddy/marketing.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format json
	}
}

# ═══════════════════════════════════════════════════════════════════════
# Analytics (Umami) — separate compose project, shared edge network
# ═══════════════════════════════════════════════════════════════════════
# Cookieless analytics dashboard + tracker. Own per-host HTTP-01 cert, kept
# off the *.{domain} wildcard key like the operator and marketing hosts.
# Reached by container name over the shared `uptimepage_default` network;
# Umami publishes no host port. No edge CSP — Umami sets its own headers and
# an imposed policy would break its dashboard.
analytics.{$UPTIMEPAGE_DOMAIN} {
	encode gzip zstd

	# /api/send takes no auth and the website id ships in public HTML. A
	# browser cannot lie about Origin, so this turns away other sites and
	# stale self-host builds; a client that forges the header still gets in.
	# `beacon_headers` in src/analytics.rs names the app host to match.
	@foreign_beacon {
		path /api/send
		method POST
		not {
			header Origin https://{$UPTIMEPAGE_DOMAIN}
			header Origin https://app.{$UPTIMEPAGE_DOMAIN}
		}
	}
	respond @foreign_beacon 403

	# A cache JWT from the auth-free /api/send used to pass as a share token
	# (GHSA-3xx8-742v-m4mq, whose record still wrongly reads patched: none).
	# Upstream added a type claim check in 3.2.0, but both tokens are still
	# signed with one secret, and 2.x ships on without the check — so this
	# covers anything older. The header is the replay's only carrier. Cost:
	# every shared view (website, board, pixel, link) 403s for whoever opens
	# it, while creating one still appears to work. We publish none.
	@share_replay header x-umami-share-token *
	respond @share_replay "share tokens are refused at the edge" 403

	reverse_proxy umami:3000

	header {
		-Server
		-X-Powered-By
	}

	log {
		output file /var/log/caddy/access-analytics.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format json
	}
}
