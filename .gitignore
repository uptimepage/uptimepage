/target
**/*.rs.bk
*.pdb

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Local agent config
CLAUDE.md
claude.md
.claude/
.agents/
skills-lock.json

# Local specs (not tracked in vcs)
/specs/

# SEO working state (audits, crawl evidence, briefs): local-only, regenerable
/.seoagent/

# Local real-target seed (points at live public endpoints — keep private)
/scripts/seed-real.sh

# Operator documents; this repo is public. They live in uptimepage-ops.
/docs/internal/gdpr-requests-log.md
/docs/internal/legal-review-checklist.md

# Internal ops runbooks (local-only; operational notes, not shipped docs)
/runbooks/

# Tailwind standalone CLI (downloaded by scripts/fetch-tailwind.sh)
/bin/tailwindcss

# esbuild standalone binary (downloaded by scripts/fetch-esbuild.sh)
/bin/esbuild

# Tailwind build output (regenerated by build.rs)
/static/css/app.css
/static/css/.tailwind.lock

# esbuild output: bundled+hashed JS from assets/js (regenerated by build.rs).
# Vendored libs (echarts/htmx/qrcode/json-enc) stay tracked at static/js/.
/static/js/ui/
/static/js/public/
/static/js/charts/
/static/js/marketing/
/static/js/architecture/
/static/js/manifest.json
/static/js/.esbuild-meta.json

# Release-only brotli siblings of CSS/JS assets (written by build.rs).
/static/**/*.br

# Secrets and local-only test overrides (never commit)
.env
# Minted agent tokens for the local multi-region harness (scripts/dev-regions.sh)
.dev-agents.env
*.local
*.local.yml

# SSH keys for server access (never commit)
/hetzner
/hetzner.pub

# Terraform — state lives in HCP Terraform Cloud, never the repo.
# .terraform.lock.hcl IS committed (provider version pinning).
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Terraform auto-merges override files — never let one carry inline creds.
terraform/override.tf
terraform/*_override.tf
crash.log
crash.*.log

# Local flow-testing browser binary (just flow-dev)
/lightpanda
