#!/usr/bin/env bash
# Cheap checks that mirror the `lint` job in .github/workflows/ci.yml.
# The test suite stays in CI / `just ci` — too slow for every commit.
#
# Install: `just install-hooks` (or `git config core.hooksPath .githooks`).
# Bypass for an emergency commit: `git commit --no-verify`.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

fail=0
run() {
  local label=$1
  shift
  printf '\033[1;34m• %s\033[0m\n' "$label"
  if ! "$@"; then
    printf '\033[1;31m✗ %s failed\033[0m\n' "$label"
    fail=1
  fi
}

run "cargo fmt --check" cargo fmt --all -- --check
# `--all-targets` mirrors CI exactly (benches + examples + bins). Without
# this, struct-literal drift in `benches/*.rs` passes local clippy and only
# fails on the CI runner, costing a re-push.
run "cargo clippy" cargo clippy --all-targets --no-deps -- -D warnings

# Workflow path-filter parity (ci.yml ↔ release-image.yml). Pure-YAML check,
# no ast-grep needed; self-skips when pyyaml is absent. Local-only by design.
run "workflow filters sync" scripts/check_workflow_filters_sync.sh

# The sitemap serves docs/index.toml's `lastmod` verbatim and crawlers schedule off it,
# so a rewritten page keeping last month's date goes unnoticed until the next
# full crawl. Needs per-file git history, which the image build does not have.
run "doc lastmod" scripts/check_doc_lastmod.sh

if command -v ast-grep >/dev/null 2>&1; then
  run "tenant-isolation scan" scripts/check_tenant_isolation.sh
  run "static lints" scripts/check_static_lints.sh
else
  printf '\033[1;33m• tenant-isolation + static-lint scans skipped (ast-grep not installed; brew install ast-grep)\033[0m\n'
fi

exit "$fail"
